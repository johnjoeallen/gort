// warning: `sync (writes b)` is nested inside `sync (writes a)`, two different objects
// warning: lock both in one block, `sync (writes a, b)`, so the order is the same no matter how they are written
package t
struct Acct { n: i64 }
fn move(a: Ref<Acct>, b: Ref<Acct>) {
    sync (writes a) {
        a.n = a.n - 1
        sync (writes b) { b.n = b.n + 1 }
    }
}
fn main() { move(new Acct { n: 1 }, new Acct { n: 0 }) }
