package t
exception Full { cap: i64 }
struct Q { n: i64 }
fn push(q: Ref<Q>, cap: i64) throws Full {
    mutate(q) {
        if (q.n >= cap) throw Full(cap)             // the lock is released on the way out
        q.n = q.n + 1
    }
}
fn main() {
    let q = new Q { n: 0 }
    var i = 0
    while (i < 5) {
        try {
            push(q, 3)
        } catch (e: Full) {
            println("full at " + str(e.cap))
        }
        i = i + 1
    }
    var k = 0
    while (k < 10) {
        k = k + 1
        mutate(q) {
            if (k % 2 == 0) { continue }            // continue and break leave the block too
            if (k > 6) { break }
            q.n = q.n + 10
        }
    }
    sync(q) { println(q.n) }
    mutate(q) { q.n = 0 }
    println(k)
}
