// three threads read in long, overlapping blocks without pause, so the reader count never reaches zero by chance; a fourth needs to write.
// Without a bound on overtaking it would wait for ever (and trap after 5 s); once it has waited 1 ms, new readers queue behind it.
package t
struct St { stop: i64, seen: i64 }
fn burn(k: i64): i64 {
    var i = 0
    var s = 0
    while (i < k) { s = s + i % 7; i = i + 1 }
    return s
}
fn reader(st: Ref<St>) {
    var done = false
    while (!done) {
        sync (reads st) {
            if (burn(300000) < 0) { println(0) }
            if (st.stop == 1) { done = true }
        }
    }
}
fn writer(st: Ref<St>) {
    sync (writes st) { st.stop = 1; st.seen = st.seen + 1 }
}
extern fn startThread(body: fn())
extern fn joinAll()
fn main() {
    let st = new St { stop: 0, seen: 0 }
    startThread(fn() { reader(st) })
    startThread(fn() { reader(st) })
    startThread(fn() { reader(st) })
    startThread(fn() { burn(1500000); writer(st) })
    joinAll()
    sync (reads st) { println(st.seen) }
}
