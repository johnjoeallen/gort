package t
struct P { x: i64, y: i64 }
fn main() {
    let s = "hello"
    let t = s.copy()
    println(t + "!" + str(t == s))
    var a = [1, 2, 3]
    var b = a.copy()
    b[0] = 9
    println(str(a[0]) + " " + str(b[0]) + " " + str(b.length))
    let bytes = "abc".toBytes()
    let c = bytes[1..3].copy()
    println(String.toString(c))
    var ps = new P[2]
    ps[1] = P { x: 5, y: 6 }
    let qs = ps.copy()
    ps[1] = P { x: 0, y: 0 }
    println(qs[1].x)
    let e = new i64[0]
    println(e.copy().length)
}
