// an array field reached through a parameter or the receiver: the caller holds a block on that array
package t
struct G {
    xs: Array<i64>
    fn bump() { self.xs[0] = self.xs[0] + 1 }
    fn first(): i64 { return self.xs[0] }
    fn second(): i64 { return self.xs[1] }
}
let shared: Ref<G> = new G { xs: [1, 2] }
fn get(): Ref<G> { return shared }
fn add(g: Ref<G>, n: i64) { g.xs[1] = g.xs[1] + n }
fn main() {
    let g = get()
    sync (writes g.xs) { g.bump(); add(g, 10) }
    sync (reads g.xs) { println(str(g.first()) + " " + str(g.second())) }
}
