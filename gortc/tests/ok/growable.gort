package t
struct Item { name: String, n: i64 }
fn main() {
    let a = Array<u8>()
    println(a.capacity())
    a[0] = 7
    a[1] = 8
    a[2] = 9
    a.moveWithin(1..3, 0)
    println(a[0])
    println(a[1])
    a.grow()
    println(a.capacity())
    println(a[1])
    let items = [Item { name: "x", n: 1 }, Item { name: "y", n: 2 }]
    for (it in items) { println(it.name) }
    let nums = [10, 20, 30]
    println(nums[2])
    let e = [1.5, 2.5]
    println(e.length)
}
