// error: calling `size`, which reads mutable fields of an object reached through its argument, needs `sync (reads db.store)`
package t
struct Store { n: i64 }
fn bump(s: Ref<Store>) { sync (writes s) { s.n = s.n + 1 } }
struct Db { store: Ref<Store> }
fn size(db: Ref<Db>): i64 { return db.store.n }
let shared: Ref<Db> = new Db { store: new Store { n: 0 } }
fn getDb(): Ref<Db> { return shared }
fn main() {
    bump(new Store { n: 0 })
    let db = getDb()
    println(str(size(db)))
}
