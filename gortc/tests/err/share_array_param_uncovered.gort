// error: calling `bump`, which writes an array field of its argument, needs `sync (writes g.xs)`
package t
struct G { xs: Array<i64> }
let shared: Ref<G> = new G { xs: [1, 2] }
fn get(): Ref<G> { return shared }
fn bump(g: Ref<G>) { g.xs[0] = g.xs[0] + 1 }
fn main() {
    let g = get()
    bump(g)
}
