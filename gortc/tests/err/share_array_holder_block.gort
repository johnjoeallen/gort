// error: needs `sync (writes g.xs)`
// a block on the holder does not cover the array a callee reaches through it
package t
struct G { xs: Array<i64> }
let shared: Ref<G> = new G { xs: [1, 2] }
fn get(): Ref<G> { return shared }
fn bump(g: Ref<G>) { g.xs[0] = 1 }
fn main() {
    let g = get()
    sync (writes g) { bump(g) }
}
