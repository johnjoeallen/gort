// error: writing `Db.n` needs mutate(db): the object is not local and is mutable
package t
struct Db { n: i64 }
extern fn spawnTask(body: fn())
fn bump(d: Ref<Db>) { mutate(d) { d.n = d.n + 1 } }
fn make(): Ref<Db> {
    let d = new Db { n: 0 }
    spawn bump(d)                 // published before it is returned: not fresh
    return d
}
fn main() {
    let db = make()
    db.n = 5
}
