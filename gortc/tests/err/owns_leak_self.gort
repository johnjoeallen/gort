    n: i64
    fn leak(h: Ref<Holder>) { h.keep = self }
}
struct A { owns b: Ref<B> }
fn go(a: Ref<A>, h: Ref<Holder>) { sync (reads a) { a.b.leak(h) } }
fn main() { }
