// error: writing `B.n` needs `sync (writes a.b)`
package t
struct B { n: i64 }
struct A { b: Ref<B> }
extern fn startThread(body: fn())
fn bump(a: Ref<A>) { sync (writes a) { a.b.n = a.b.n + 1 } }
fn main() {
    let b = new B { n: 0 }
    let x = new A { b: b }
    let y = new A { b: b }
    startThread(fn() { bump(x) })
    startThread(fn() { bump(y) })
}
