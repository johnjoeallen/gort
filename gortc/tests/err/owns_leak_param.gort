// error: `a.b` is owned by its struct and cannot be copied out, stored, returned or captured
// stash keeps the handle it is given, so an owned child cannot be passed to it
package t
struct B { n: i64 }
struct Holder { keep: Ref<B>? }
struct A { owns b: Ref<B> }
fn stash(h: Ref<Holder>, b: Ref<B>) { h.keep = b }
fn leak(a: Ref<A>, h: Ref<Holder>) { sync (reads a) { stash(h, a.b) } }
fn main() { }
