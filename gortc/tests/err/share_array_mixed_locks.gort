// error: `G.xs` is locked through its holder elsewhere (a receiver or parameter) and by a block on the array itself here
// `bump` locks the holder, `viaCopy` locks the array itself: different locks, so the two could race. One style per array field.
package t
struct G { xs: Array<i64> }
let shared: Ref<G> = new G { xs: [1, 2] }
fn get(): Ref<G> { return shared }
fn bump(g: Ref<G>) { g.xs[0] = g.xs[0] + 1 }
fn viaCopy() {
    let g = get()
    let xs = g.xs
    sync (writes xs) { xs[0] = xs[0] + 1 }
}
fn main() {
    let g = get()
    sync (writes g) { bump(g) }
    viaCopy()
    sync (reads g.xs) { println(str(g.xs[0])) }
}
