// expect-exit: 101
// stderr: mutate on an object this call tree already holds
package t
struct Node { n: i64 }
fn walk(x: Ref<Node>, depth: i64) {
    mutate(x) {
        x.n = x.n + 1
        if (depth > 0) { walk(x, depth - 1) }       // the same object, one level down
    }
}
fn main() { walk(new Node { n: 0 }, 3) }
