// expect-exit: 101
// stderr: a sync cannot become a mutate
package t
struct Node { n: i64 }
struct Holder { node: Ref<Node> }
fn poke(h: Ref<Holder>) { mutate(h.node) { h.node.n = 9 } }
fn main() {
    let x = new Node { n: 0 }
    let h = new Holder { node: x }
    sync(x) { println(x.n); poke(h) }       // the alias through h is not visible to the compiler
}
