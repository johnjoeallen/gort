// http-mid/router.gort - the route table and the handlers.
// A route is a method, a path pattern ("/kv/:key", see pattern.gort) and a function. The table is a list built once, from the
// last route to the first, and never changed, so every worker reads it with no lock.
package http

struct Route {
    method: String
    pattern: String
    handler: fn(Request, Array<u8>, shared Store, Params): ref Resp
    next: shared Route?
}

// ---------- handlers: (request, body, store, the path parameters) ----------

fn hHello(req: Request, body: Array<u8>, store: shared Store, p: Params): ref Resp {
    return respond(200, "hello\n", req.keepAlive, req.http10)
}

fn hHealth(req: Request, body: Array<u8>, store: shared Store, p: Params): ref Resp {
    return respond(200, "ok\n", req.keepAlive, req.http10)
}

fn hEcho(req: Request, body: Array<u8>, store: shared Store, p: Params): ref Resp {
    return respondBytes(200, "application/octet-stream", body, req.keepAlive, req.http10)
}

fn hGet(req: Request, body: Array<u8>, store: shared Store, p: Params): ref Resp {
    let key = p.get("key") ?? ""
    var found: String? = null
    sync (reads store.kv) { found = store.kv.get(key) }
    if (found == null) return respond(404, "no such key\n", req.keepAlive, req.http10)
    return respond(200, found + "\n", req.keepAlive, req.http10)
}

fn hPut(req: Request, body: Array<u8>, store: shared Store, p: Params): ref Resp {
    let key = p.get("key") ?? ""
    if (key.length == 0) return respond(400, "empty key\n", req.keepAlive, req.http10)
    var existed = false
    sync (writes store.kv) {
        existed = store.kv.has(key)
        store.kv.insert(key, String.toString(body))
    }
    sync (writes store) { store.writes += 1 }
    if (existed) return respond(200, "replaced\n", req.keepAlive, req.http10)
    return respond(201, "created\n", req.keepAlive, req.http10)
}

fn hDelete(req: Request, body: Array<u8>, store: shared Store, p: Params): ref Resp {
    let key = p.get("key") ?? ""
    var existed = false
    sync (writes store.kv) {
        existed = store.kv.has(key)
        store.kv.remove(key)
    }
    if (!existed) return respond(404, "no such key\n", req.keepAlive, req.http10)
    sync (writes store) { store.writes += 1 }
    return respond(204, "", req.keepAlive, req.http10)
}

fn hStats(req: Request, body: Array<u8>, store: shared Store, p: Params): ref Resp {
    var keys: usize = 0
    sync (reads store.kv) { keys = store.kv.count }
    var requests: u64 = 0
    var writes: u64 = 0
    sync (reads store) { requests = store.requests; writes = store.writes }
    return respond(200, "keys " + keys + "\nrequests " + requests + "\nwrites " + writes + "\n", req.keepAlive, req.http10)
}

fn hGreet(req: Request, body: Array<u8>, store: shared Store, p: Params): ref Resp {
    let name = p.get("name") ?? ""
    let text = "hello, " + name + "\n"
    let shout = queryGet(req.query, "shout")
    if (shout != null && shout != "0") return respond(200, "hello, " + name + "!\n", req.keepAlive, req.http10)
    return respond(200, text, req.keepAlive, req.http10)
}

// ---------- the table ----------

fn buildRoutes(): shared Route {
    shared Route r8 = new Route { method: "GET",    pattern: "/stats",      handler: hStats,  next: null }
    shared Route r7 = new Route { method: "GET",    pattern: "/hello/:name", handler: hGreet, next: r8 }
    shared Route r6 = new Route { method: "DELETE", pattern: "/kv/:key",    handler: hDelete, next: r7 }
    shared Route r5 = new Route { method: "PUT",    pattern: "/kv/:key",    handler: hPut,    next: r6 }
    shared Route r4 = new Route { method: "GET",    pattern: "/kv/:key",    handler: hGet,    next: r5 }
    shared Route r3 = new Route { method: "POST",   pattern: "/echo",       handler: hEcho,   next: r4 }
    shared Route r2 = new Route { method: "GET",    pattern: "/health",     handler: hHealth, next: r3 }
    shared Route r1 = new Route { method: "GET",    pattern: "/",           handler: hHello,  next: r2 }
    return r1
}

// Finds the route for a request and runs it: 404 if no path matches, 405 if the path matches but not the method.
fn dispatch(req: Request, body: Array<u8>, store: shared Store, routes: shared Route): ref Resp {
    sync (writes store) { store.requests += 1 }
    var cur: shared Route? = routes
    var pathSeen = false
    let path = req.path.toBytes()
    while (cur != null) {
        if (patternMatches(cur.pattern.toBytes(), path)) {
            if (req.method == cur.method) {
                let h = cur.handler
                return h(req, body, store, Params { pattern: cur.pattern, path: req.path })
            }
            pathSeen = true
        }
        cur = cur.next
    }
    if (pathSeen) return respond(405, "method not allowed\n", req.keepAlive, req.http10)
    return respond(404, "not found\n", req.keepAlive, req.http10)
}
