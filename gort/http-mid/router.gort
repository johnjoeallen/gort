// http-mid/router.gort - the route table and the handlers.
// A route is a method, a path pattern ("/kv/:key", see pattern.gort) and a function. The table is a list built once, from the
// last route to the first, and never changed, so every worker reads it with no lock.
package http

// Which reader a route uses. Memory: the whole body is read into memory first, at most ServerConfig.maxBody. Upload: the route states its own larger
// limit, the body is spooled to an unnamed temporary file as it arrives (memory does not grow with it), and the handler gets the finished file to
// link into place or read.
enum Handler {
    Memory(fn(Request, Array<u8>, shared Store, Params): Reply throws Exception)
    Upload(u64, fn(Request, Upload, shared Store, Params): Reply throws Exception)      // (limit, handler)
}

struct Route {
    method: Method
    pattern: String
    handler: Handler
    cost: Cost = Cost.Bounded(50.ms)
    streams: bool = false           // the answer is streamed (a file, chunks): it is sent by the connection's own vthread, alone, so the route is a barrier
    next: shared Route?

    // A safe route has no side effects the next request could observe (GET, HEAD, OPTIONS): such requests may run side by side. Anything else is a barrier.
    fn safe(): bool { return method == Method.Get || method == Method.Head || method == Method.Options }

    // null: the route reads its body into memory; otherwise the most bytes its upload may have.
    fn uploadLimit(): u64? {
        switch (handler) {
            Memory(_) -> { return null }
            Upload(limit, _) -> { return limit }
        }
    }
}

// ---------- handlers: (request, body, store, the path parameters) ----------

fn hHello(req: Request, body: Array<u8>, store: shared Store, p: Params): Reply {
    return reply(200, "hello\n")
}

fn hHealth(req: Request, body: Array<u8>, store: shared Store, p: Params): Reply {
    return reply(200, "ok\n")
}

fn hEcho(req: Request, body: Array<u8>, store: shared Store, p: Params): Reply {
    return Reply.bytes(200, req.header("content-type") ?? "application/octet-stream", body)
}

fn hGet(req: Request, body: Array<u8>, store: shared Store, p: Params): Reply {
    let key = p.get("key") ?? ""
    var found: String? = null
    sync (reads store.kv) { found = store.kv.get(key) }
    if (found == null) return reply(404, "no such key\n")
    return reply(200, found + "\n")
}

fn hPut(req: Request, body: Array<u8>, store: shared Store, p: Params): Reply {
    let key = p.get("key") ?? ""
    if (key.length == 0) return reply(400, "empty key\n")
    var existed = false
    sync (writes store.kv) {
        existed = store.kv.has(key)
        store.kv.insert(key, String.toString(body))
    }
    sync (writes store) { store.writes += 1 }
    if (existed) return reply(200, "replaced\n")
    return reply(201, "created\n").with("Location", "/kv/" + percentEncode(key))
}

fn hDelete(req: Request, body: Array<u8>, store: shared Store, p: Params): Reply {
    let key = p.get("key") ?? ""
    var existed = false
    sync (writes store.kv) {
        existed = store.kv.has(key)
        store.kv.remove(key)
    }
    if (!existed) return reply(404, "no such key\n")
    sync (writes store) { store.writes += 1 }
    return reply(204, "")
}

fn hStats(req: Request, body: Array<u8>, store: shared Store, p: Params): Reply {
    var keys: usize = 0
    sync (reads store.kv) { keys = store.kv.count }
    var requests: u64 = 0
    var writes: u64 = 0
    sync (reads store) { requests = store.requests; writes = store.writes }
    return reply(200, "keys " + keys + "\nrequests " + requests + "\nwrites " + writes + "\n")
}

exception Boom { reason: String }

// A handler that fails, to show that a throw answers 500 and the connection lives on.
fn hBoom(req: Request, body: Array<u8>, store: shared Store, p: Params): Reply throws Exception {
    if (queryGet(req.query, "ok") != null) return reply(200, "fine\n")
    throw Boom("asked to")
}

fn hGreet(req: Request, body: Array<u8>, store: shared Store, p: Params): Reply {
    let name = p.get("name") ?? ""
    let text = "hello, " + name + "\n"
    let shout = queryGet(req.query, "shout")
    if (shout != null && shout != "0") return reply(200, "hello, " + name + "!\n")
    return reply(200, text)
}

// ---------- files: uploads kept in the upload directory ----------

// A name safe to use as a file in the directory: no slash, no control byte, not hidden, not empty or too long.
fn validFileName(name: String): bool {
    let b = name.toBytes()
    if (b.length == 0 || b.length > 200 || b[0] == 46) return false
    var i: usize = 0
    while (i < b.length) {
        if (b[i] == 47 || b[i] < 32 || b[i] == 127) return false
        i += 1
    }
    return true
}

fn hFilePut(req: Request, up: Upload, store: shared Store, p: Params): Reply throws Exception {
    let name = p.get("name") ?? ""
    if (!validFileName(name)) return reply(400, "bad file name\n")
    let path = store.dir + "/" + name
    let old = File.open(path)
    let existed = old != null
    up.file.linkAs(path)                                         // the unnamed file gets its name; an older file of that name is replaced
    sync (writes store) { store.writes += 1 }
    if (existed) return reply(200, "replaced " + up.length + " bytes\n")
    return reply(201, "stored " + up.length + " bytes\n").with("Location", "/files/" + percentEncode(name))
}

// The content type for a file name, by its extension.
fn contentTypeFor(name: String): String {
    let b = name.toBytes()
    var dot = b.length
    var i: usize = 0
    while (i < b.length) {
        if (b[i] == 46) dot = i
        i += 1
    }
    if (dot >= b.length) return "application/octet-stream"
    let ext = b[dot + 1..b.length]
    if (ext.equalsIgnoreCase("txt")) return "text/plain"
    if (ext.equalsIgnoreCase("html") || ext.equalsIgnoreCase("htm")) return "text/html"
    if (ext.equalsIgnoreCase("css")) return "text/css"
    if (ext.equalsIgnoreCase("js")) return "text/javascript"
    if (ext.equalsIgnoreCase("json")) return "application/json"
    if (ext.equalsIgnoreCase("png")) return "image/png"
    if (ext.equalsIgnoreCase("jpg") || ext.equalsIgnoreCase("jpeg")) return "image/jpeg"
    if (ext.equalsIgnoreCase("gif")) return "image/gif"
    if (ext.equalsIgnoreCase("svg")) return "image/svg+xml"
    if (ext.equalsIgnoreCase("pdf")) return "application/pdf"
    return "application/octet-stream"
}

// A requested byte range of a file of `size` bytes, both ends included. `ok` false: it lies outside the file (416).
struct ByteRange { start: u64, end: u64, ok: bool }

// The single range of a `Range: bytes=a-b` / `a-` / `-n` header; null if there is no usable one (another unit, several ranges, a malformed value): the
// whole file is served then, as the RFC allows.
fn parseRange(header: String, size: u64): ByteRange? {
    let h = header.toBytes()
    if (h.length < 7 || !h[0..6].equalsIgnoreCase("bytes=")) return null
    let spec = h[6..h.length]
    if (indexOf(spec, 44, 0) < spec.length) return null              // several ranges: not supported
    let dash = indexOf(spec, 45, 0)
    if (dash >= spec.length) return null
    let first = spec[0..dash]
    let last = spec[dash + 1..spec.length]
    if (first.length == 0) {                                          // "-n": the last n bytes
        let n = parseUsize(last)
        if (n == null) return null
        if (n == 0 || size == 0) return ByteRange { start: 0, end: 0, ok: false }
        let want = n as u64
        return ByteRange { start: (want >= size) ? 0 : size - want, end: size - 1, ok: true }
    }
    let s = parseUsize(first)
    if (s == null) return null
    let start = s as u64
    var end: u64 = (size == 0) ? 0 : size - 1
    if (last.length > 0) {
        let e = parseUsize(last)
        if (e == null || (e as u64) < start) return null              // not a range at all
        if ((e as u64) < end) end = e as u64
    }
    if (start >= size) return ByteRange { start: 0, end: 0, ok: false }
    return ByteRange { start: start, end: end, ok: true }
}

// Streams the file: it is never read into memory, however large. A Range header gets 206 with the part asked for.
fn hFileGet(req: Request, body: Array<u8>, store: shared Store, p: Params): Reply throws Exception {
    let name = p.get("name") ?? ""
    if (!validFileName(name)) return reply(400, "bad file name\n")
    let f = File.open(store.dir + "/" + name)
    if (f == null) return reply(404, "no such file\n")
    let size = f.length()
    let type = contentTypeFor(name)
    let wanted = req.header("range")
    let range = (wanted == null) ? null : parseRange(wanted, size)
    if (range == null) return Reply.file(200, type, f, 0, size).with("Accept-Ranges", "bytes")
    if (!range.ok) return reply(416, "range not satisfiable\n").with("Content-Range", "bytes */" + size)
    return Reply.file(206, type, f, range.start, range.end - range.start + 1)
        .with("Content-Range", "bytes " + range.start + "-" + range.end + "/" + size).with("Accept-Ranges", "bytes")
}

fn hFileDelete(req: Request, body: Array<u8>, store: shared Store, p: Params): Reply throws Exception {
    let name = p.get("name") ?? ""
    if (!validFileName(name)) return reply(400, "bad file name\n")
    if (!File.remove(store.dir + "/" + name)) return reply(404, "no such file\n")
    sync (writes store) { store.writes += 1 }
    return reply(204, "")
}

// ---------- users: JSON in, JSON out ----------

struct User { name: String, email: String?, age: u16? }

// `s` as a JSON string literal.
fn jsonQuote(s: String): String {
    let b = s.toBytes()
    var out = Array<u8>()
    out.append(34)
    var i: usize = 0
    while (i < b.length) {
        let c = b[i]
        if (c == 34 || c == 92) { out.append(92); out.append(c) }
        else if (c == 10) { out.append(92); out.append(110) }
        else if (c == 13) { out.append(92); out.append(114) }
        else if (c == 9) { out.append(92); out.append(116) }
        else if (c < 32) { out.append("\\u00".toBytes()); out.append(hexDigit(c / 16)); out.append(hexDigit(c % 16)) }
        else { out.append(c) }
        i += 1
    }
    out.append(34)
    return String.toString(out)
}

fn userJson(id: i64, u: User): String {
    return "{\"id\":" + id + ",\"name\":" + jsonQuote(u.name)
        + (u.email == null ? "" : ",\"email\":" + jsonQuote(u.email))
        + (u.age == null ? "" : ",\"age\":" + u.age) + "}\n"
}

fn hUserCreate(req: Request, body: Array<u8>, store: shared Store, p: Params): Reply throws Exception {
    let ctype = req.header("content-type") ?? ""
    if (!ctype.startsWith("application/json")) return reply(415, "send application/json\n")
    var parsed: User? = null
    try {
        parsed = json.parse<User>(body, JsonLimits { maxDepth: 8, maxStringBytes: 256 })
    } catch (e: JsonError) {
        return reply(400, "invalid JSON: " + e.message + "\n")
    }
    if (parsed == null || parsed.name.length == 0) return reply(400, "a user needs a name\n")
    var id: i64 = 0
    sync (writes store.users, store) {                           // both at once, in one order
        id = store.nextUserId
        store.nextUserId += 1
        store.users.insert(id, userJson(id, parsed))
    }
    return Reply.bytes(201, "application/json", userJson(id, parsed).toBytes()).with("Location", "/users/" + id)
}

fn hUserGet(req: Request, body: Array<u8>, store: shared Store, p: Params): Reply throws Exception {
    let id = (p.get("id") ?? "").toBytes()
    let n = parseUsize(id)
    if (n == null) return reply(404, "no such user\n")
    var found: String? = null
    sync (reads store.users) { found = store.users.get(n as i64) }
    if (found == null) return reply(404, "no such user\n")
    return Reply.bytes(200, "application/json", found.toBytes())
}

// ---------- slow handlers, to show what concurrency buys ----------

fn millisFrom(p: Params, name: String): usize {
    let n = parseUsize((p.get(name) ?? "").toBytes()) ?? 0
    return (n > 5000) ? 5000 : n
}

// Parks for the given time: with requests pipelined, the waits overlap.
fn hSleep(req: Request, body: Array<u8>, store: shared Store, p: Params): Reply throws Exception {
    let ms = millisFrom(p, "ms")
    sleep(Duration.millis(ms))
    return reply(200, "slept " + ms + "\n")
}

// Holds the worker for the given time without parking: declared Unbounded, so it runs alone.
fn hSpin(req: Request, body: Array<u8>, store: shared Store, p: Params): Reply throws Exception {
    let ms = millisFrom(p, "ms")
    let started = Instant.now()
    let wanted = Duration.millis(ms)
    while (Instant.now() - started < wanted) { }
    return reply(200, "spun " + ms + "\n")
}

// ---------- a chunked body from a producer ----------

// n lines (at most 1000), one chunk each, `ms` milliseconds apart: /stream/5?ms=100. The writer runs after the head is out.
fn writeLines(req: Request, p: Params, out: Sink) throws IoError {
    let n = millisFrom(p, "n")
    let delay = parseUsize((queryGet(req.query, "ms") ?? "").toBytes()) ?? 0
    let total = (n > 1000) ? 1000 : n
    var i: usize = 0
    while (i < total) {
        if (i > 0 && delay > 0) sleep(Duration.millis(delay))
        out.writeText("line " + i + "\n")
        i += 1
    }
}

fn hStream(req: Request, body: Array<u8>, store: shared Store, p: Params): Reply throws Exception {
    return Reply.stream(200, "text/plain", p, writeLines)
}

// ---------- the table ----------

fn mem(h: fn(Request, Array<u8>, shared Store, Params): Reply throws Exception): Handler { return Handler.Memory(h) }

fn buildRoutes(): shared Route {
    shared Route r18 = new Route { method: Method.Get,    pattern: "/stream/:n",  handler: mem(hStream), streams: true, next: null }
    shared Route r17 = new Route { method: Method.Get,    pattern: "/stats",      handler: mem(hStats),  next: r18 }
    shared Route r16 = new Route { method: Method.Get,    pattern: "/spin/:ms",   handler: mem(hSpin), cost: Cost.Unbounded, next: r17 }
    shared Route r15 = new Route { method: Method.Get,    pattern: "/sleep/:ms",  handler: mem(hSleep), cost: Cost.Bounded(5.s), next: r16 }
    shared Route r14 = new Route { method: Method.Get,    pattern: "/users/:id",  handler: mem(hUserGet), next: r15 }
    shared Route r13 = new Route { method: Method.Post,   pattern: "/users",      handler: mem(hUserCreate), next: r14 }
    shared Route r12 = new Route { method: Method.Delete, pattern: "/files/:name", handler: mem(hFileDelete), next: r13 }
    shared Route r11 = new Route { method: Method.Get,    pattern: "/files/:name", handler: mem(hFileGet), streams: true, next: r12 }
    shared Route r10 = new Route { method: Method.Put,    pattern: "/files/:name", handler: Handler.Upload(64.mb, hFilePut), next: r11 }
    shared Route r8 = new Route { method: Method.Get,    pattern: "/boom",       handler: mem(hBoom),   next: r10 }
    shared Route r7 = new Route { method: Method.Get,    pattern: "/hello/:name", handler: mem(hGreet), next: r8 }
    shared Route r6 = new Route { method: Method.Delete, pattern: "/kv/:key",    handler: mem(hDelete), next: r7 }
    shared Route r5 = new Route { method: Method.Put,    pattern: "/kv/:key",    handler: mem(hPut),    next: r6 }
    shared Route r4 = new Route { method: Method.Get,    pattern: "/kv/:key",    handler: mem(hGet),    next: r5 }
    shared Route r3 = new Route { method: Method.Post,   pattern: "/echo",       handler: mem(hEcho),   next: r4 }
    shared Route r2 = new Route { method: Method.Get,    pattern: "/health",     handler: mem(hHealth), next: r3 }
    shared Route r1 = new Route { method: Method.Get,    pattern: "/",           handler: mem(hHello),  next: r2 }
    return r1
}

// The first route that matches the request's path and method (HEAD matches a GET route); null if there is none.
fn findRoute(req: Request, routes: shared Route): shared Route? {
    let head = req.method == Method.Head
    let path = req.path.toBytes()
    var cur: shared Route? = routes
    while (cur != null) {
        if (patternMatches(cur.pattern.toBytes(), path) && (req.method == cur.method || (head && cur.method == Method.Get))) return cur
        cur = cur.next
    }
    return null
}

// What a request gets when no route takes it: 404 if no path matches; 405 (with an Allow header) if a path matches but not the method; OPTIONS on a
// known path lists what it allows.
fn noRoute(req: Request, routes: shared Route): Reply {
    var allow = ""
    let path = req.path.toBytes()
    var cur: shared Route? = routes
    while (cur != null) {
        if (patternMatches(cur.pattern.toBytes(), path)) {
            allow = allow + (allow.length == 0 ? "" : ", ") + cur.method.name() + (cur.method == Method.Get ? ", HEAD" : "")
        }
        cur = cur.next
    }
    if (allow.length == 0) return reply(404, "not found\n")
    if (req.method == Method.Options) return reply(204, "").with("Allow", allow + ", OPTIONS")
    return reply(405, "method not allowed\n").with("Allow", allow + ", OPTIONS")
}

// Runs the route's handler; whatever it throws ends this request only: the client gets a 500 and the connection stays open.
fn runRoute(route: shared Route, req: Request, body: Array<u8>, up: Upload?, store: shared Store): Reply {
    let params = Params { pattern: route.pattern, path: req.path }
    try {
        switch (route.handler) {
            Memory(h) -> { return h(req, body, store, params) }
            Upload(_, h) -> {
                if (up == null) return reply(500, "internal error\n")       // the server read the body the wrong way: cannot happen
                return h(req, up, store, params)
            }
        }
    } catch (e: Exception) {
        logLine((req.method.name() + " " + req.path + ": the handler threw\n").toBytes())
        return reply(500, "internal error\n")
    }
}

// The reply to a request whose body has been read (into `body`, or spooled into `up` for an upload route). It counts the request.
fn answer(req: Request, body: Array<u8>, up: Upload?, store: shared Store, routes: shared Route): Reply {
    sync (writes store) { store.requests += 1 }
    let route = findRoute(req, routes)
    return (route == null) ? noRoute(req, routes) : runRoute(route, req, body, up, store)
}

// ... rendered into bytes: HEAD gets the GET handler's answer without the body. (A streaming route is not dispatched this way: see sendStream.)
fn dispatch(req: Request, body: Array<u8>, up: Upload?, store: shared Store, routes: shared Route): ref Resp {
    return render(answer(req, body, up, store, routes), req.keepAlive, req.http10, req.method != Method.Head)
}
