// http-mid/types.gort - requests, responses and how a connection loop ended.
package http
import runtime

// One response. Built per request, so it belongs to the connection's vthread: a `ref`.
struct Resp { bytes: Array<u8>, keepAlive: bool }

// The parsed head of a request. `head` and the positions are offsets into the reader's buffer; the strings are copies.
struct Request {
    method: String
    path: String
    query: String
    keepAlive: bool
    http10: bool            // the client speaks HTTP/1.0
    contentLength: usize
    headEnd: usize          // where the head ends in the reader's buffer (the body starts here)
}

exception TooLarge                                      // the header block does not fit in the buffer
exception BodyTooLarge                                  // Content-Length is above the limit
exception BadRequest                                    // the head is malformed

enum Ending {
    ClientClosed             // the peer closed it, or it failed: nothing more can arrive
    ServerClosed             // the server ended it after a normal answer (Connection: close, HTTP/1.0)
    ServerRejected           // the server ended it with an ERROR answer: the client is probably still sending
}
