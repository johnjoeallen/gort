// http-mid/config.gort - the settings the loop reads.
package http

struct ServerConfig {
    maxHead: usize = 16.kb         // largest accepted header block (431 beyond it)
    maxBody: usize = 1.mb          // largest accepted request body (413 beyond it)
    depth: usize = 16              // pipelined requests answered per write (the next write waits for none of them)
    maxBatch: usize = 64.kb        // ... and the answers are written once they add up to this many bytes
    lingerTime: Duration = 2.s     // after the server ends a connection while the client may still be sending: keep reading this long
    lingerBytes: u64 = 256.mb      // ... and at most this many bytes, then close
}
