// http-mid/store.gort - the state every worker and every connection shares.
package http

struct Store {
    kv: shared Map<String, String>       // the key-value data behind /kv/:key
    requests: u64 = 0                    // every request handled, by any worker
    dir: String                          // where uploaded files are kept
    users: shared Map<i64, String>       // the JSON of each user, by id
    nextUserId: i64 = 1
    writes: u64 = 0                      // successful PUT and DELETE
}

fn newStore(dir: String): shared Store {
    return new Store { kv: new Map<String, String> {}, dir: dir, users: new Map<i64, String> {} }
}
